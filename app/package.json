{
    "name": "lol-config-editor",
    "private": true,
    "license": "MIT",
    "version": "2.0.0",
    "packageManager": "bun@1.4.4",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "build:exe": "tauri build --no-bundle",
        "lint": "tsc --noEmit && prettier --check . && vitest run",
        "format": "prettier --write .",
        "test": "vitest run",
        "audit": "bun audit --audit-level=high"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.3.1",
        "@tauri-apps/api": "^2.12",
        "@tauri-apps/plugin-dialog": "^2.8.4",
        "@tauri-apps/plugin-process": "^2.4",
        "@tauri-apps/plugin-updater": "^2.14.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.8"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@tauri-apps/cli": "^2.12",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "axe-core": "^4.14.1",
        "jsdom": "^31.0.1",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    }
}
