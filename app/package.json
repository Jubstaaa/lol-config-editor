{
    "name": "lol-config-editor",
    "private": true,
    "license": "MIT",
    "version": "2.0.0",
    "packageManager": "bun@1.4.4",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "build:exe": "tauri build --no-bundle",
        "lint": "tsc --noEmit && prettier --check . && vitest run",
        "format": "prettier --write .",
        "test": "vitest run",
        "audit": "bun audit --audit-level=high"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@tauri-apps/api": "^2.12",
        "@tauri-apps/plugin-dialog": "^2.8.4",
        "@tauri-apps/plugin-process": "^2.4",
        "@tauri-apps/plugin-updater": "^2.14.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.8",
        "tailwindcss": "^4.3.5"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "prettier": "^3.10.1",
        "typescript": "~5.8.3",
        "vite": "^8.3.8",
        "vitest": "^4.1.11"
    }
}
