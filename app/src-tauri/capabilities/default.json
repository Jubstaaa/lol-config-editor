{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Only what the renderer calls: switch-progress events, the folder picker, and checking for and installing an update",
    "windows": ["main"],
    "permissions": [
        "core:event:allow-listen",
        "core:event:allow-unlisten",
        "dialog:allow-open",
        "updater:allow-check",
        "updater:allow-download-and-install",
        "process:allow-restart"
    ]
}
